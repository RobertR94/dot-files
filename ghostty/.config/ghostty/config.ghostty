# Theme
theme = coolnight

# Environment
term = xterm-256color

# Window
window-padding-x = 10
window-padding-y = 10

# Similar to Alacritty decorations = "Buttonless" on macOS
macos-titlebar-style = hidden

fullscreen = true

# Blur only has visible effect if opacity is below 1.0
background-opacity = 0.95
background-blur = true

# Font
font-size = 14

font-family = "MesloLGS Nerd Font Mono"
font-family-bold = "MesloLGS Nerd Font Mono"
font-family-italic = "MesloLGS Nerd Font Mono"
font-family-bold-italic = "MesloLGS Nerd Font Mono"
